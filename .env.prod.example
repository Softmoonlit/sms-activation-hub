# 生产环境配置模板
# 用法：
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#   # 编辑 .env.prod，将所有 replace-* 替换为真实值

# ── 运行环境 ─────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── 数据库 ────────────────────────────────────────────────────────────────────
# 使用 Docker Compose 内部服务名 postgres 作为主机名
DATABASE_URL=postgres://sms_website:replace-with-strong-postgres-password@postgres:5432/sms_website

# PostgreSQL 数据库密码（必须与 DATABASE_URL 中的密码保持一致）
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# ── 管理后台 ──────────────────────────────────────────────────────────────────
# 6~12 位字母或数字，避免常见后台名称（如 admin、login）
ADMIN_PATH=replace-with-6to12-alphanumeric

# 管理员登录密码，建议 32 位以上随机字符
ADMIN_PASSWORD=replace-with-a-long-unique-password

# 会话签名密钥，建议 64 位以上随机字符
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# ── HeroSMS ───────────────────────────────────────────────────────────────────
# HeroSMS 平台 API 密钥
HEROSMS_API_KEY=replace-with-your-hero-sms-api-key

# Webhook 路径秘密段，32~128 位随机字母、数字、下划线或连字符
HEROSMS_WEBHOOK_PATH=replace-with-at-least-32-random-characters

# 允许发送 Webhook 的来源 IP（逗号分隔），填写 HeroSMS 官方回调 IP
HEROSMS_WEBHOOK_ALLOWED_IPS=203.0.113.10

# Webhook 限流（每分钟最大请求数，默认 120）
HEROSMS_WEBHOOK_REQUESTS_PER_MINUTE=120

# ── OpenAI ────────────────────────────────────────────────────────────────────
# 经 HeroSMS 服务列表确认的 OpenAI 服务代码（1~32 位字母或数字）
OPENAI_SERVICE_CODE=replace-with-confirmed-hero-sms-service-code

# ── 网络 ──────────────────────────────────────────────────────────────────────
# 反向代理地址，Caddy 在宿主机 + Docker 部署时填 127.0.0.1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
TRUSTED_PROXY=127.0.0.1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# 公开访问域名（含协议），用于生成回调链接
PUBLIC_ORIGIN=https://sms.example.com

# 应用监听端口（容器内端口，一般不需要修改）
PORT=3001
