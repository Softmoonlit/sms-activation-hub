{
  "name": "sms-activation-hub",
  "version": "1.0.0",
  "private": true,
  "description": "临时短信激活授权平台",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --import tsx scripts/run-tests.ts",
    "test:unit": "node --import tsx --test test/config.test.ts test/country-calling-code.test.ts test/country-flag.test.ts test/herosms.test.ts test/test-database-runner.test.ts",
    "test:node": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts",
    "test:e2e": "node --import tsx scripts/run-tests.ts --playwright"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
